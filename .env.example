# Airbnb AI Agent - Environment Variables

# ── LLM Provider (Guest Chatbot) ──────────────────────────────
# Default provider: z.ai (OpenAI-compatible)
# Get your key at: https://bigmodel.cn/usercenter/proj-mgmt/apikeys

ZAI_API_KEY=your_zai_api_key_here

# Optional: OpenAI instead of z.ai
#OPENAI_API_KEY=your_openai_key_here
#LLM_PROVIDER=openai

# ── Airbnb Scraping ───────────────────────────────────────────
# No API key needed — pyairbnb fetches a temporary key automatically.
#AIRBNB_API_KEY=

# ── Telegram Notifications ────────────────────────────────────
#TELEGRAM_BOT_TOKEN=your_bot_token
#TELEGRAM_CHAT_ID=your_chat_id

# ── Email Notifications ───────────────────────────────────────
#EMAIL_SENDER=your_email@gmail.com
#EMAIL_PASSWORD=your_app_password
#EMAIL_RECIPIENT=recipient@example.com
